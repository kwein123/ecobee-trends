# Copy to .env (setup.sh does this for you) and edit as needed.

# Host port the dashboard listens on.
DASHBOARD_PORT=8321

# Seconds between polls of the ecobee API. ecobee refreshes its cloud data
# every few minutes, so values under ~180 just record duplicates.
POLL_INTERVAL=300

# Container image to run. Leave as-is to build locally, or point at a
# published image to skip the build:
#   ECOBEE_IMAGE=ghcr.io/kwein123/ecobee-trends:latest
# ECOBEE_IMAGE=ecobee-trends:local
